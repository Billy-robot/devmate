# 忽略以下生成文件与本地配置。

# 依赖
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 测试
/coverage

# Next.js
/.next/
/out/

# 生产构建
/build

# 其他
.DS_Store
*.pem

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 环境变量文件（示例文件可单独加入版本控制）
.env*
!.env.example
!.env.*.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
